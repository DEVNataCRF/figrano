{
  "name": "figrano",
  "version": "0.1.0",
  "description": "Figrano: atendimento automático de pedidos pelo WhatsApp para restaurantes",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "probe": "electron . --probe",
    "test": "node --test",
    "icon": "node scripts/make-icon.js",
    "dist": "npm run icon && npm run panel && electron-builder --win --publish never",
    "release": "npm test && npm run icon && npm run panel && electron-builder --win --publish always",
    "panel": "node scripts/build-panel.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@wppconnect/wa-js": "4.8.2",
    "electron-updater": "^6.8.11",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "author": "Figrano",
  "build": {
    "appId": "br.figrano.app",
    "productName": "Sabores da Sil",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Sabores da Sil",
      "artifactName": "SaboresDaSil-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DEVNataCRF",
        "repo": "figrano-releases"
      }
    ],
    "extraResources": [
      {
        "from": "panel",
        "to": "panel"
      }
    ]
  }
}
